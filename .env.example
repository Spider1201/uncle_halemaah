# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Auth.js / Google provider
AUTH_SECRET="replace-with-long-random-secret"
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"
# Google Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# Add https://your-production-domain/api/auth/callback/google for production.

# Mailgun
MAILGUN_API_KEY="your-mailgun-api-key"
MAILGUN_DOMAIN="mg.your-domain.com"
MAILGUN_FROM_EMAIL="no-reply@your-domain.com"
